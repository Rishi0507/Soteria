{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soteria.dev/contracts/events/containment.action.proposed.v1.json",
  "title": "containment.action.proposed.v1",
  "description": "A containment action below the auto-hold confidence threshold: queued for human confirmation in the ops console. Producer: containment-service. Consumers: ops-console, audit-proof-service.",
  "type": "object",
  "required": ["incident_id", "action_id", "proposed_at", "confidence", "threshold", "targets", "reason"],
  "additionalProperties": false,
  "properties": {
    "incident_id": { "type": "string" },
    "action_id":   { "type": "string", "format": "uuid" },
    "proposed_at": { "type": "string", "format": "date-time" },
    "confidence":  { "type": "number", "minimum": 0, "maximum": 1 },
    "threshold":   { "type": "number", "minimum": 0, "maximum": 1, "description": "auto-hold cutoff in force at decision time" },
    "reason":      { "type": "string" },
    "hazard":      { "type": "string" },
    "targets":     { "type": "array", "minItems": 1, "items": { "$ref": "https://soteria.dev/contracts/events/_containment_target.v1.json" } }
  }
}
