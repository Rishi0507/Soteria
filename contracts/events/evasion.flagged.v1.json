{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soteria.dev/contracts/events/evasion.flagged.v1.json",
  "title": "evasion.flagged.v1",
  "description": "A recalled lot reappeared on a liquidation/resale marketplace after its recall date. Producer: anti-evasion-service. Consumers: audit-proof-service, notification-service.",
  "type": "object",
  "required": ["incident_id", "flag_id", "marketplace", "listing_url", "observed_at", "confidence"],
  "additionalProperties": false,
  "properties": {
    "incident_id": { "type": "string" },
    "flag_id":     { "type": "string", "format": "uuid" },
    "marketplace": { "type": "string" },
    "listing_url": { "type": "string" },
    "listing_title": { "type": "string" },
    "seller":      { "type": "string" },
    "gtin":        { "type": "string" },
    "lot_code":    { "type": "string" },
    "observed_at": { "type": "string", "format": "date-time" },
    "confidence":  { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence":    { "type": "array", "items": { "type": "string" } }
  }
}
