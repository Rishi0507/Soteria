{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soteria.dev/contracts/events/containment.action.taken.v1.json",
  "title": "containment.action.taken.v1",
  "description": "Inventory was actually held/zeroed in the commerce platform. Producer: containment-service. Consumers: storefront, audit-proof-service, notification-service, order-rescue-service.",
  "type": "object",
  "required": ["incident_id", "action_id", "taken_at", "decision", "actor", "confidence", "targets", "results"],
  "additionalProperties": false,
  "properties": {
    "incident_id": { "type": "string" },
    "action_id":   { "type": "string", "format": "uuid" },
    "taken_at":    { "type": "string", "format": "date-time" },
    "decision":    { "type": "string", "enum": ["AUTO_HOLD", "HUMAN_CONFIRMED", "HUMAN_REJECTED", "RELEASED"] },
    "actor":       { "type": "string", "description": "'system' for AUTO_HOLD, else the ops user id" },
    "confidence":  { "type": "number", "minimum": 0, "maximum": 1 },
    "threshold":   { "type": "number", "minimum": 0, "maximum": 1 },
    "hazard":      { "type": "string" },
    "targets":     { "type": "array", "minItems": 1, "items": { "$ref": "https://soteria.dev/contracts/events/_containment_target.v1.json" } },
    "results": {
      "type": "array",
      "description": "per-target outcome of the commerce-platform write; the audit dossier depends on this being complete",
      "items": {
        "type": "object",
        "required": ["gtin", "status"],
        "additionalProperties": false,
        "properties": {
          "gtin":              { "type": "string" },
          "status":            { "type": "string", "enum": ["HELD", "SKIPPED", "FAILED", "RELEASED"] },
          "platform":          { "type": "string", "enum": ["shopify"] },
          "platform_ref":      { "type": "string", "description": "e.g. shopify inventory_item_id" },
          "units_held":        { "type": "integer", "minimum": 0 },
          "units_left_sellable": { "type": "integer", "minimum": 0, "description": "the surgical-containment win: unaffected lots still sellable" },
          "error":             { "type": "string" }
        }
      }
    }
  }
}
