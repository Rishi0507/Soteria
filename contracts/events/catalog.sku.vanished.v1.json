{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soteria.dev/contracts/events/catalog.sku.vanished.v1.json",
  "title": "catalog.sku.vanished.v1",
  "description": "A SKU quietly disappeared from a distributor/manufacturer catalog snapshot (silent recall signal). Producer: ingestion-silent-diff. Consumer: resolution-service.",
  "type": "object",
  "required": ["catalog_source", "sku", "observed_at", "vanish_confidence"],
  "additionalProperties": false,
  "properties": {
    "catalog_source":     { "type": "string" },
    "sku":                { "type": "string" },
    "upc":                { "type": "string" },
    "product_description":{ "type": "string" },
    "brand_name":         { "type": "string" },
    "lots_last_seen":     { "type": "array", "items": { "type": "string" } },
    "last_seen_at":       { "type": "string", "format": "date-time" },
    "observed_at":        { "type": "string", "format": "date-time" },
    "vanish_confidence":  { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
