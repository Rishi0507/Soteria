{
  "name": "Soteria - service health check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{\"json\": {\"service\": \"ingestion-fda\", \"url\": \"http://ingestion-fda:8080/healthz\"}}, {\"json\": {\"service\": \"ingestion-usda\", \"url\": \"http://ingestion-usda:8080/healthz\"}}, {\"json\": {\"service\": \"ingestion-rasff\", \"url\": \"http://ingestion-rasff:8080/healthz\"}}, {\"json\": {\"service\": \"resolution-service\", \"url\": \"http://resolution-service:8081/healthz\"}}, {\"json\": {\"service\": \"containment-service\", \"url\": \"http://containment-service:8082/healthz\"}}, {\"json\": {\"service\": \"order-rescue-service\", \"url\": \"http://order-rescue-service:8083/healthz\"}}, {\"json\": {\"service\": \"notification-service\", \"url\": \"http://notification-service:8084/healthz\"}}];"
      },
      "id": "targets",
      "name": "Service list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "probe",
      "name": "GET /healthz",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "unhealthy",
      "name": "Unhealthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ':rotating_light: *' + $('Service list').item.json.service + '* is unhealthy (HTTP ' + $json.statusCode + ')\\n```' + JSON.stringify($json.body).slice(0, 1500) + '```' }) }}",
        "options": {}
      },
      "id": "alert",
      "name": "Slack alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        200
      ]
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Service list",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Service list": {
      "main": [
        [
          {
            "node": "GET /healthz",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET /healthz": {
      "main": [
        [
          {
            "node": "Unhealthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unhealthy?": {
      "main": [
        [
          {
            "node": "Slack alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
