# Copy to infra/.env. Everything is optional: unset means fixtures, and every
# service says so at startup rather than pretending.

# Broker credentials. No password is committed anywhere; unset means a
# development account with a placeholder password.
RABBITMQ_USER=soteria
RABBITMQ_PASSWORD=

# Shopify: set both or neither. Setting one alone is a startup error, because a
# service that believes it is writing to a store while running on fixtures would
# publish containment events describing holds that never happened.
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
QUARANTINE_LOCATION=Quarantine

# Containment thresholds. SKU scope is deliberately stricter: pulling an entire
# product line should be harder than pulling a lot.
AUTO_HOLD_THRESHOLD=0.85
SKU_SCOPE_THRESHOLD=0.95

# Order rescue: HMAC secret for customer consent tokens. Without it the service
# starts with a known development value and warns; see docs/security-review.md.
CONSENT_SECRET=

# Audit: RFC 3161 timestamp authority. TSA_DISABLED=1 still produces dossiers,
# hash-chained but not anchored in time, and they say so on their face.
TSA_URL=http://timestamp.digicert.com
TSA_DISABLED=
