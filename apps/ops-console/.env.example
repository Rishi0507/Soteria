# Service origins. Ports come from the `servers:` block of each OpenAPI spec in
# contracts/openapi, not from guesswork:
#   containment-api.v1.yaml -> http://localhost:8082
#   audit-api.v1.yaml       -> http://localhost:8084
#
# Both services read CORS_ALLOWED_ORIGINS and reject browser calls from an origin
# they were not told about. Running this console against them means starting each
# with CORS_ALLOWED_ORIGINS=http://localhost:5174 (this app's dev origin).
VITE_CONTAINMENT_API_URL=http://localhost:8082
VITE_AUDIT_API_URL=http://localhost:8084

# Opt-in, dev-only MSW. See src/main.tsx.
VITE_USE_MOCKS=false
