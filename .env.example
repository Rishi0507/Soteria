# Copy to .env in a service directory (or export in the environment). Every
# ingestion service reads these; service-specific keys are marked.

# RabbitMQ (dev broker: docker compose -f libs/feedkit/dev/docker-compose.yml up -d)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Poll cadence and first-run window
POLL_INTERVAL=5m
BACKFILL_DAYS=30

# Health/metrics listener and dedup store
HTTP_ADDR=:8080
DB_PATH=data/ingestion.db
LOG_LEVEL=info

# Goes into the User-Agent header; some feeds require a contact
CONTACT_EMAIL=ops@soteria.dev

# ingestion-fda: optional free key from https://open.fda.gov/apis/authentication/
# (40 req/min without, 240 req/min with)
OPENFDA_API_KEY=

# ingestion-usda: override when fsis.usda.gov must be reached via a US-egress
# proxy or a fixture server (the site 403s some non-US networks). Go's HTTP
# client also honors HTTPS_PROXY.
FSIS_BASE_URL=

# ingestion-rasff: file (default) reads exports from RASFF_FILE_DIR; http is
# reserved for a verified portal adapter and currently refuses to start.
RASFF_MODE=file
RASFF_FILE_DIR=fixtures

# libs/shopify (containment, order rescue, shopctl). Custom-app Admin API token
# from the dev store; never commit it.
SHOPIFY_SHOP=soteria-dev.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-01

# notification-service. Without these, alerts/emails are printed to stdout.
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
EMAIL_FROM=Soteria Alerts <onboarding@resend.dev>
RESCUE_CONSENT_URL=http://localhost:5173/rescue/{rescue_id}
RETAILER_NAME=

# ingestion-silent-diff (Python). Sources in services/ingestion-silent-diff/sources.yaml.
MIN_CONFIDENCE=0.5
OFF_ENRICH=0
POLL_INTERVAL_SECONDS=3600

# recall-extractor (LLM entity extraction). Free key at console.groq.com.
# Without it the service can only serve cached/recorded extractions.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
